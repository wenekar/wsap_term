option(
    'window_backend',
    type: 'combo',
    choices: ['auto', 'wayland', 'x11', 'metal'],
    value: 'auto',
    description: 'Window backend (Wayland and X11 are Linux-only, Metal is macOS-only)',
)
option(
    'vulkan_render',
    type: 'combo',
    choices: ['auto', 'enabled', 'disabled'],
    value: 'auto',
    description: 'Vulkan GPU rendering backend (Linux default when Vulkan 1.3 and glslc are available)',
)
option(
    'font_backend',
    type: 'combo',
    choices: ['auto', 'coretext', 'freetype'],
    value: 'auto',
    description: 'Font rasterization and discovery backend (CoreText is macOS-only)',
)
option(
    'isa',
    type: 'string',
    value: 'auto',
    description: 'Compiler -march target. auto uses native for an app build and the compiler default for a framework-only build; empty uses the compiler default; native forces the native target. The term core picks its SIMD level at run time, at or above this target',
)
option(
    'tests',
    type: 'boolean',
    value: true,
    description: 'Build and register tests',
)
option(
    'test_link_groups',
    type: 'boolean',
    value: true,
    description: 'Share links for tests without stubs or allocation overrides',
)
option(
    'benchmarks',
    type: 'boolean',
    value: true,
    description: 'Build and register benchmarks',
)
option(
    'write_fuzz_seeds',
    type: 'integer',
    min: 1,
    value: 1000,
    description: 'Seed count for write-fuzz-test in the test suite',
)
option(
    'integration_tests',
    type: 'boolean',
    value: false,
    description: 'Register tests requiring headless Sway and external tools',
)
option(
    'kitty_tests',
    type: 'boolean',
    value: false,
    description: 'Require the Kitty parser compatibility tests. They run on every unsanitized Linux build anyway',
)
option(
    'hardening',
    type: 'boolean',
    value: true,
    description: 'Compile-time memory safety hardening (fortify, stack protector, RELRO)',
)
option(
    'package_format',
    type: 'combo',
    choices: ['auto', 'arch', 'deb', 'rpm', 'app', 'tar'],
    value: 'auto',
    description: 'Distribution package format for dist/deploy',
)
option(
    'macos_app_dir',
    type: 'string',
    value: '',
    description: 'Directory that receives wsap_term.app on macOS; empty picks ~/Applications for a prefix under $HOME, else /Applications',
)

option(
    'dev_paths',
    type: 'boolean',
    value: true,
    description: 'Read themes and terminfo from the source tree in a development build',
)
option(
    'install_desktop',
    type: 'boolean',
    value: true,
    description: 'Install the application icon and the desktop entry',
)
option(
    'install_shell',
    type: 'boolean',
    value: true,
    description: 'Install wsap-ssh and the shell integration scripts',
)
option(
    'fastpty',
    type: 'boolean',
    value: true,
    description: 'Build and install the libfastpty preload helper',
)
