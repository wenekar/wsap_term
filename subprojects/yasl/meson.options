option('wayland', type: 'feature', value: 'auto', description: 'Build the Wayland backend.')
option('x11', type: 'feature', value: 'auto', description: 'Build the X11 backend.')
option('dbus', type: 'feature', value: 'auto', description: 'Use the D-Bus session bus on Linux for notifications and desktop settings.')
option('integration_tests', type: 'boolean', value: false, description: 'Test windows with Linux display servers or the native macOS display.')
option('x11_tablet_tests', type: 'boolean', value: false, description: 'Test native pressure drawing with Xorg dummy and inputtest drivers (no tablet hardware required).')
