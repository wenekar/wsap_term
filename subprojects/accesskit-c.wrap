# subproject-install.patch keeps the library, headers, and pkg-config file out
# of the install of wsap_term, which links the library statically. The framework
# copy of this wrap does not apply it, because the framework SDK installs them.
diff_files = accesskit-c/meson-version.patch, accesskit-c/cargo-release.patch, accesskit-c/subproject-install.patch

[provide]
dependency_names = accesskit-c-0.23
