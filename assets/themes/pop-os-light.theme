# Theme metadata. The label names the theme in the picker.
# The polarity is dark or light.
# The terminal app reads the [ansi] block. Other blocks are
# available to an application that knows them.

label = Pop!_OS Light
polarity = light

[ansi]
foreground = #1B1B1B
background = #E8E8E8
color0 = #1B1B1B
color1 = #A24F50
color2 = #437E4F
color3 = #7D6E1E
color4 = #516D94
color5 = #9A30CA
color6 = #227A85
color7 = #AFAFAF
color8 = #000000
color9 = #890418
color10 = #185529
color11 = #534800
color12 = #2E496D
color13 = #6B0091
color14 = #00525A
color15 = #C9C9C9
