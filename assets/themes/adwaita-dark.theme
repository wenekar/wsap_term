# Theme metadata. The label names the theme in the picker.
# The polarity is dark or light.
# The terminal app reads the [ansi] block. Other blocks are
# available to an application that knows them.

label = Adwaita Dark
polarity = dark

[ansi]
foreground = #CFCFCF
background = #1E1E1E
color0 = #353535
color1 = #CC1E2A
color2 = #26A269
color3 = #A2734C
color4 = #1A67C6
color5 = #A347BA
color6 = #2AA1B3
color7 = #CFCFCF
color8 = #686868
color9 = #F66151
color10 = #33D17A
color11 = #E9AD0C
color12 = #2A7BDE
color13 = #C061CB
color14 = #33C7DE
color15 = #FFFFFF
