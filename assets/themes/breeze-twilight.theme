# Theme metadata. The label names the theme in the picker.
# The polarity is dark or light.
# The terminal app reads the [ansi] block. Other blocks are
# available to an application that knows them.

label = Breeze Twilight
polarity = dark

[ansi]
foreground = #FCFCFC
background = #232627
color0 = #373B3D
color1 = #ED1515
color2 = #11D116
color3 = #F67400
color4 = #1D99F3
color5 = #9B59B6
color6 = #1ABC9C
color7 = #FCFCFC
color8 = #7F8C8D
color9 = #C83B2D
color10 = #1CDC9A
color11 = #FDBC4B
color12 = #3DAEE9
color13 = #994DB9
color14 = #16A085
color15 = #FFFFFF
