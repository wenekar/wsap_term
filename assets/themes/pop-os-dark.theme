# Theme metadata. The label names the theme in the picker.
# The polarity is dark or light.
# The terminal app reads the [ansi] block. Other blocks are
# available to an application that knows them.

label = Pop!_OS Dark
polarity = dark

[ansi]
foreground = #C4C4C4
background = #1B1B1B
color0 = #323232
color1 = #F16161
color2 = #7CB987
color3 = #DDC74C
color4 = #6296BE
color5 = #BE6DEE
color6 = #49BAC8
color7 = #BEBEBE
color8 = #808080
color9 = #FF8985
color10 = #97D5A0
color11 = #FAE365
color12 = #7DB1DA
color13 = #D68EFF
color14 = #49BAC8
color15 = #C4C4C4
